# ============================================================
# مرآتي الرقمية — مثال إعدادات البيئة (انسخه إلى .env واملأ القيم)
# لا تضع أي قيم سرية حقيقية في هذا الملف — هذا نموذج فقط
# ============================================================

# --- عام ---
PORT=3000
# عنوان الموقع المصرح به (للسيشن والكوكيز) — ضع النطاق النهائي في الإنتاج
PUBLIC_BASE_URL=http://localhost:3000
# بيئة التشغيل: development | production
NODE_ENV=development

# --- مساعد الذكاء الاصطناعي (اختياري تماماً) ---
# بدون هذه القيم يعمل المساعد بمحرك الأدلة الإرشادية الموثقة (Playbooks) فقط
# مزوّد متوافق مع OpenAI API
AI_PROVIDER=none            # none | openai-compatible
AI_BASE_URL=                # مثال: https://api.openai.com/v1
AI_API_KEY=                 # ضع المفتاح في ملف .env فقط، وليس في الكود أبداً
AI_MODEL=                   # مثال: gpt-4o-mini
AI_MAX_TOKENS_PER_RESPONSE=1200
AI_TIMEOUT_MS=20000

# --- فحص تسريبات البريد (اختياري — يتطلب مفتاح HIBP API مدفوع) ---
# بدون المفتاح تظهر الأداة رسالة "الخدمة غير مفعّلة" بصدق بدلاً من نتائج وهمية
# https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

# --- حساب مدير المحتوى ---
# أنشئ hash بكلمة: npm run db:reset ثم اتبع التعليمات، أو استخدم ADMIN_PASSWORD
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-production
# جلسة موقعة — احرف عشوائية طويلة في الإنتاج
SESSION_SECRET=generate-a-long-random-string

# --- المستشار الذكي (غرفة الحوار التوعوية) ---
# مزود افتراضي مجاني بلا مفتاح: Pollinations (مُختبَر بالعربية)
# يمكن استبداله بأي نقطة نهاية متوافقة مع OpenAI — مع مفتاحها الخاص إن لزم
CHAT_BASE_URL=https://text.pollinations.ai/openai
CHAT_MODEL=openai
CHAT_TIMEOUT_MS=55000

# --- الفاحص الشامل للروابط (اختياري — الفحوص الأساسية تعمل بلا مفاتيح) ---
# الفحوص المجانية بلا مفتاح: تحليل بنيوي + قاعدة Phishing Army (147 ألف نطاق) + عمر النطاق عبر RDAP + فحص محتوى آمن
# التكاملات التالية ترفع الدقة عند توفرها (تظهر "معطل" بصدق بدونها):
VT_API_KEY=              # مفتاح مجاني من virustotal.com (70+ فاحصاً)
GSB_API_KEY=             # مفتاح Google Safe Browsing من Google Cloud
URLHAUS_AUTH_KEY=        # مفتاح مجاني بالتسجيل في abuse.ch (قاعدة مالوير)

# --- طبقة البحث/التحقق من المصادر (اختياري) ---
RESEARCH_ENABLED=false
